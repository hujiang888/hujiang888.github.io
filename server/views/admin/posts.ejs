<%- include('partials/head', { title: '文章' }) %>
<%- include('partials/top', { active: 'posts', title: '文章', subtitle: '笔记列表与发布状态' }) %>

<div class="admin-card">
  <div class="admin-card__head">
    <div><h2>文章列表</h2><p><%= posts.length %> 篇 · 前台地址 /post/slug</p></div>
    <a class="btn btn--accent admin-small-btn" href="/admin/posts/new">新建文章</a>
  </div>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead><tr><th>排序</th><th>标题</th><th>日期</th><th>分类</th><th>操作</th></tr></thead>
      <tbody>
        <% posts.forEach((post, index) => { %>
          <tr>
            <td><%= String(index + 1).padStart(2, '0') %></td>
            <td><strong><%= post.title %></strong><small><%= post.slug %></small></td>
            <td><%= post.date_text %></td>
            <td><%= post.category %></td>
            <td class="admin-table__actions">
              <a href="/admin/posts/<%= post.id %>/edit">编辑</a>
              <a href="/post/<%= post.slug %>" target="_blank" rel="noreferrer">查看</a>
              <form method="post" action="/admin/posts/<%= post.id %>/delete" data-confirm="确定删除这篇文章吗？">
                <input type="hidden" name="_csrf" value="<%= csrf %>" />
                <button class="link-danger" type="submit">删除</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/bottom') %>
